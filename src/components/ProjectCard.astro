---
interface Props {
  title: string;
  description: string;
  year: string;
  tags: string[];
  website?: string;
  github?: string;
  featured?: boolean;
  index: number;
}

const { title, description, year, tags, website, github, featured = false, index } = Astro.props;
const delay = Math.min(index + 2, 8);
---

<article
  class:list={[
    "project-card",
    "animate-fade-up",
    `delay-${delay}`,
    { featured },
  ]}
>
  <div class="card-inner">
    <header class="card-header">
      <span class="year font-mono">{year}</span>
      {featured && <span class="featured-badge">Featured</span>}
    </header>

    <h3 class="card-title font-display">{title}</h3>

    <p class="card-description">{description}</p>

    <footer class="card-footer">
      <ul class="tags">
        {tags.map((tag) => <li class="tag font-mono">{tag}</li>)}
      </ul>
      <div class="links">
        {website && (
          <a href={website} class="link" target="_blank" rel="noopener noreferrer" aria-label={`${title} website`}>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="2" y1="12" x2="22" y2="12"></line>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
            </svg>
          </a>
        )}
        {github && (
          <a href={github} class="link" target="_blank" rel="noopener noreferrer" aria-label={`${title} on GitHub`}>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
          </a>
        )}
      </div>
    </footer>
  </div>
</article>

<style>
  .project-card {
    position: relative;
  }

  .card-inner {
    position: relative;
    padding: 1.75rem;
    height: 100%;
    min-height: 220px;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-border-subtle);
    border-radius: 2px;
    background: var(--color-bg);
    transition:
      border-color var(--duration-normal) var(--ease-out-expo),
      background var(--duration-normal) var(--ease-out-expo);
  }

  .project-card:hover .card-inner {
    border-color: var(--color-border);
    background: var(--color-bg-elevated);
  }

  .card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .year {
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    color: var(--color-fg-subtle);
    text-transform: uppercase;
  }

  .featured-badge {
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
    padding: 0.25rem 0.5rem;
    border: 1px solid var(--color-accent-glow);
    border-radius: 1px;
    background: var(--color-accent-subtle);
  }

  .card-title {
    font-size: 1.375rem;
    font-weight: 400;
    line-height: 1.3;
    margin: 0 0 0.75rem 0;
    color: var(--color-fg);
    transition: color var(--duration-fast) var(--ease-out-expo);
  }

  .project-card:hover .card-title {
    color: var(--color-accent);
  }

  .card-description {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-fg-muted);
    margin: 0;
    flex: 1;
  }

  .card-footer {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-top: 1.25rem;
    gap: 1rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tag {
    font-size: 0.7rem;
    letter-spacing: 0.03em;
    color: var(--color-fg-subtle);
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--color-border-subtle);
    border-radius: 1px;
    transition: border-color var(--duration-fast) var(--ease-out-expo);
  }

  .project-card:hover .tag {
    border-color: var(--color-border);
  }

  .links {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .link {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-fg-subtle);
    transition: color var(--duration-fast) var(--ease-out-expo);
  }

  .link:hover {
    color: var(--color-accent);
  }

  /* Featured card styling */
  .featured .card-inner {
    border-color: var(--color-border);
  }

  .featured .card-inner::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      var(--color-accent-glow),
      transparent
    );
  }
</style>
